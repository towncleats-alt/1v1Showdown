APP_ENV=development
APP_URL=http://127.0.0.1:4000
API_PORT=4000
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000

# PostgreSQL credentials. Copy this file to .env and replace every value.
POSTGRES_DB=faisalabad_1v1
POSTGRES_USER=faisalabad_app
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://faisalabad_app:replace-with-a-long-local-password@127.0.0.1:55432/faisalabad_1v1
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Keep the real key only in .env or your deployment secret manager.
TOURNAMENT_API_KEY=replace-with-a-long-random-api-key

# Development seed values only. Never use these defaults in staging or production.
SEED_ADMIN_EMAIL=towncleats@gmail.com
SEED_ADMIN_PASSWORD=03045534884.Mm

# ── Notifications ──────────────────────────────────────────────────────────────
# Email via SMTP (optional — leave blank to skip emails, system still works fully)
# Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=1 ON 1 Showdown <your-email@gmail.com>

# WhatsApp admin number (digits only, with country code, no + or spaces)
ADMIN_WHATSAPP=923045534884

# ── Production / Netlify + Render deployment ───────────────────────────────────
# Set these in the Render dashboard (backend) and Netlify dashboard (frontend).
# Never commit real values here.
#
# [Render — backend service env vars]
# APP_ENV=production
# API_PORT=4000
# DATABASE_URL=<auto-injected by Render when DB is linked>
# DATABASE_SSL=true
# CORS_ORIGINS=https://your-site.netlify.app
# TOURNAMENT_API_KEY=<generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
# SEED_ADMIN_EMAIL=your-admin@gmail.com
# SEED_ADMIN_PASSWORD=<strong password>
#
# [Netlify — build environment variable]
# API_URL=https://your-app.onrender.com   ← your Render service URL
